# Copy to .env and fill in what you need. Every value has a safe default
# (see src/project_health_agent/core/config.py) except where noted.

# --- Runtime environment -----------------------------------------------------
ENVIRONMENT=development          # development | staging | production | test
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text (local dev) | json (log aggregators)

# --- LLM provider (optional — pipeline runs with a deterministic fallback
#     if left blank; see README section 3) ------------------------------------
LLM_PROVIDER=none                # groq | gemini | none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Data source ---------------------------------------------------------------
# local: read every *.xlsx from LOCAL_DATA_DIR (default: sample_data/)
# drive: sync every workbook in a shared Google Drive folder before each run
#        (see docs/GOOGLE_DRIVE_SETUP.md) — this is the "no manual file
#        handling, company folder stays the source of truth" mode.
DATA_SOURCE=local
LOCAL_DATA_DIR=sample_data

# Required only when DATA_SOURCE=drive:
DRIVE_FOLDER_URL=                # e.g. https://drive.google.com/drive/folders/1AbC...
GOOGLE_SERVICE_ACCOUNT_FILE=     # path to a service-account JSON key file
# Alternative to the file above, for CI (base64-encoded JSON contents):
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
DRIVE_CACHE_DIR=var/cache/drive
DRIVE_MAX_RETRIES=4
DRIVE_TIMEOUT_SECONDS=30

# --- Output paths ----------------------------------------------------------------
WEEKLY_OUTPUT_DIR=var/outputs/weekly
MONTHLY_OUTPUT_DIR=var/outputs/monthly

# --- Misc ------------------------------------------------------------------------
TODAYS_DATE_OVERRIDE=             # YYYY-MM-DD, for reproducible demo/test runs

# --- Streamlit frontend (frontend/) ------------------------------------------
# Read directly by frontend/api_client.py, not by Settings above — the
# frontend is a separate process talking to the API over HTTP.
PHA_API_BASE_URL=http://localhost:8000
